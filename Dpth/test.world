<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="depth_test_world">

    <!-- ========== PHYSICS & SENSORS PLUGINS (Harmonic style) ========== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-rendering-system" name="gz::sim::systems::Rendering"/>
ss

    <!-- ========== GROUND PLANE ========== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== SUN LIGHT ========== -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 -0.5 -0.5 0</pose>
      <direction>0 0 -1</direction>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </light>

    <!-- ========== DEPTH CAMERA MODEL (Harmonic demo style) ========== -->
    <model name="depth_cam_test">
      <static>false</static>
      <link name="depth_cam_link">
        <!-- Position camera 0.5 m above ground -->
        <pose>0 0 0.5 0 0 0</pose>

        <sensor name="depth_camera1" type="depth_camera">
          <!-- exactly like the demo -->
          <update_rate>30</update_rate>
          <topic>depth_camera</topic>
          <enable_metrics>true</enable_metrics>

          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- ========== TEST BOX ========== -->
    <model name="test_box">
      <static>true</static>
      <link name="box_link">
        <pose>2 0 0.25 0 0 0</pose>
        <collision name="box_collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

